      "description": "Status de aprova\u00e7\u00e3o da entrevista pelo sistema externo."
    },
    "aprovacao_motivo": {
      "type": "string",
      "description": "Motivo da reprova\u00e7\u00e3o \u2014 preenchido quando aprovacao_status = 'reprovado'."
